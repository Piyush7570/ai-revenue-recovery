# Backend environment variables
# Copy this file to backend/.env and fill in values.
# Leave any key blank to use simulation/fallback mode.

# -------------------------------------------------------
# DATABASE
# -------------------------------------------------------
# SQLite path (default – no external DB required)
DATABASE_URL=sqlite:///./revenue_recovery.db

# -------------------------------------------------------
# RAZORPAY CREDENTIALS
# Leave blank to run in full simulation mode (no Razorpay account needed).
# Use Razorpay Test Mode keys for integration testing.
# -------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# -------------------------------------------------------
# AI / LLM  (Google Gemini)
# Leave blank to run in OFFLINE MODE using the deterministic
# rule-based fallback engine. No API key is required to run.
# -------------------------------------------------------
LLM_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------
# POLICY ENGINE TUNING (optional — these are the defaults)
# -------------------------------------------------------
MAX_RETRIES=3
MIN_HOURS_BETWEEN_NOTIFICATIONS=12
MAX_NOTIFICATIONS_PER_CASE=3

# -------------------------------------------------------
# SERVER
# -------------------------------------------------------
HOST=0.0.0.0
PORT=8000
